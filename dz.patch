+        # Prevent Java XML parsers in the sandbox (e.g., the H2Orestart extension)
+        # from resolving external entities/DTDs (XXE), by overriding the JDK's
+        # jaxp.properties file in the sandbox rootfs. An empty value means that no
+        # protocol (file:, http:, etc.) is allowed.
+        jaxp_props = tempfile.NamedTemporaryFile(
+            mode="w", prefix="dz-jaxp-", suffix=".properties", delete=False
+        )
+        with jaxp_props:
+            jaxp_props.write("javax.xml.accessExternalDTD=\n")
+            jaxp_props.write("javax.xml.accessExternalSchema=\n")
+            jaxp_props.write("javax.xml.accessExternalStylesheet=\n")
+        os.chmod(jaxp_props.name, 0o644)
+        jaxp_target = (
+            "/home/dangerzone/dangerzone-image/rootfs"
+            "/etc/java-21-openjdk/jaxp.properties"
+        )
+        security_args += ["-v", f"{jaxp_props.name}:{jaxp_target}:ro"]
+
         return security_args
 
